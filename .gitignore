# ---- secrets ----
.env
.env.local
.env.*.local

# ---- dependencies ----
node_modules/

# ---- build output ----
dist/
build/
*.tsbuildinfo

# ---- generated projects ----
# Project runs are local working output, not source. Ignored wholesale so a new
# output directory can never get committed by accident.
# (Files already tracked under projects/ stay tracked; see git rm --cached.)
projects/

# ---- hyperframes render artifacts ----
hyperframes/.cache/
hyperframes/out/

# ---- personal Claude Code settings ----
# settings.json is shared and committed; settings.local.json is per-developer
# and must never be. Relying on a contributor's global gitignore is not enough.
.claude/settings.local.json

# ---- test / coverage ----
coverage/
*.log

# ---- OS ----
.DS_Store
Thumbs.db
