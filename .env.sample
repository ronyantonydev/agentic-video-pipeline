# =============================================================
#  Agentic Video Pipeline — environment template
#  Copy to .env and fill in.  NEVER commit .env.
#      cp .env.sample .env
# =============================================================

# ---- Higgsfield API (images, video, audio) -------------------
# Get these from your Higgsfield account → API / Developer settings.
# Used by the REST client for cost estimation + paid generation.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Base URL for the Higgsfield platform API. Only change if told to.
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai

# ---- Who spends money ----------------------------------------
#   rest  Node calls the REST API directly. Budget enforcement is
#         mechanical - code checks before every request. Reaches the
#         dop (video) and soul (image) catalogue. Cheap: 2-9 credits
#         per clip. THE DEFAULT, and what architecture §2 requires.
#
#   mcp   Claude invokes the Higgsfield MCP tools. Reaches the premium
#         catalogue (Kling, Veo, Seedance, Cinema Studio) that the REST
#         key cannot see - roughly 45 credits per clip. The budget check
#         becomes an instruction to Claude rather than a code path.
#         Not implemented yet.
#
#   fake  Synthesised media, no network, no cost. Development and CI.
#
# The two catalogues barely overlap: they are different products, not
# one product at two prices. Changing this also changes which model ids
# a generation plan may use.
PROVIDER_MODE=rest

# ---- Budget guardrails ---------------------------------------
# Hard ceiling per project, in USD. Code refuses any paid call
# that would push total spend past this. See architecture §19.
MAX_BUDGET_USD=20

# Abort if a single generation is estimated above this (USD).
# Catches runaway settings (e.g. 4k + 30s) before they bill.
MAX_SINGLE_CALL_USD=3

# ---- Execution safety ----------------------------------------
# true  = plan and estimate only, never spend (architecture §20)
# false = paid calls permitted, subject to budget checks
DRY_RUN=false

# Max concurrent generation jobs (architecture §14).
MAX_CONCURRENCY=3

# Give up on a single job after this many seconds.
JOB_TIMEOUT_SECONDS=900

# ---- Local tooling -------------------------------------------
# Leave blank to use whatever is on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Logging -------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
