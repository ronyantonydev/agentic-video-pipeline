# =============================================================
#  Agentic Video Pipeline — environment template
#  Copy to .env and fill in.  NEVER commit .env.
#      cp .env.sample .env
# =============================================================

# ---- Who spends money ----------------------------------------
#   mcp   Claude invokes the Higgsfield MCP tools, billed against the
#         subscription credit balance. Reaches Kling, Veo, Seedance and
#         Cinema Studio. Needs NO API key - authentication is the
#         claude.ai connector. Requires these in ~/.claude/settings.json:
#           mcp__claude_ai_Higgsfield__generate_image
#           mcp__claude_ai_Higgsfield__generate_video
#           mcp__claude_ai_Higgsfield__generate_audio
#           mcp__claude_ai_Higgsfield__media_upload
#         Budget is still checked in code before every call, but the call
#         itself is made by Claude, so architecture §2 is weakened.
#
#   rest  Node calls the Higgsfield Cloud REST API directly, using the
#         key/secret below. Budget enforcement is fully mechanical.
#         Reaches only the Cloud catalogue (dop video, soul images).
#         IMPORTANT: Higgsfield Cloud has a SEPARATE credit balance from
#         the subscription. Subscription credits are NOT spendable here -
#         the Cloud wallet must be funded independently at
#         cloud.higgsfield.ai → Billing, or every request returns
#         403 not_enough_credits.
#
#   fake  Synthesised media via FFmpeg. No network, no cost. Dev and CI.
#
# Verified prices (2026-08-20, quoted live with get_cost, nothing spent):
#   MCP    Soul 2 image     0.12 cr
#          Kling 3.0   5s   7.5 cr    8s  12 cr
#          Veo 3.1 Lite 8s  8 cr
#          Seedance 2.5 5s  32.5 cr
#   REST   soul/standard    1.5 cr
#          dop/lite 2 cr, dop/turbo 6.5 cr, dop/standard 9 cr
#
# The two catalogues barely overlap - they are different products, so
# changing this also changes which model ids a generation plan may use.
PROVIDER_MODE=mcp

# ---- Higgsfield Cloud REST API -------------------------------
# ONLY used when PROVIDER_MODE=rest. Leave blank for mcp or fake.
# Create at cloud.higgsfield.ai → API Keys. Note that this wallet is
# separate from your subscription credits and must be funded on its own.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Base URL for the Higgsfield Cloud API. Only change if told to.
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai

# ---- Budget guardrails ---------------------------------------
# Hard ceiling per project, in USD. Code refuses any paid call that
# would push total spend past this. See architecture §19.
MAX_BUDGET_USD=20

# Abort if a single generation is estimated above this (USD).
# Catches runaway settings (e.g. 4k + 30s) before they bill.
MAX_SINGLE_CALL_USD=3

# ---- Execution safety ----------------------------------------
# true  = plan and estimate only, never spend (architecture §20)
# false = paid calls permitted, subject to budget checks
DRY_RUN=false

# Max concurrent generation jobs (architecture §14).
MAX_CONCURRENCY=3

# Give up on a single job after this many seconds.
JOB_TIMEOUT_SECONDS=900

# ---- Local tooling -------------------------------------------
# Leave blank to use whatever is on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Logging -------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
