{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run doctor)",
      "Bash(npm run budget:*)",
      "Bash(npm run refcheck:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "mcp__claude_ai_Higgsfield__balance",
      "mcp__claude_ai_Higgsfield__models_explore",
      "mcp__claude_ai_Higgsfield__show_plans_and_credits",
      "mcp__claude_ai_Higgsfield__job_status",
      "mcp__claude_ai_Higgsfield__jobs_wait",
      "mcp__claude_ai_Higgsfield__show_generation_by_ids",
      "mcp__claude_ai_Higgsfield__show_generations",
      "mcp__claude_ai_Higgsfield__transactions"
    ],
    "ask": [
      "Bash(npm run gen:*)",
      "Bash(npm run start:*)",
      "Bash(npm run video:*)",
      "Bash(npm run upscale:*)",
      "mcp__claude_ai_Higgsfield__generate_image",
      "mcp__claude_ai_Higgsfield__generate_image_batch",
      "mcp__claude_ai_Higgsfield__generate_video",
      "mcp__claude_ai_Higgsfield__generate_video_batch",
      "mcp__claude_ai_Higgsfield__generate_audio",
      "mcp__claude_ai_Higgsfield__generate_audio_batch",
      "mcp__claude_ai_Higgsfield__upscale_image",
      "mcp__claude_ai_Higgsfield__upscale_video"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/.env)"
    ]
  }
}
